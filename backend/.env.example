# Copy to .env for local runs. Never commit the real file.

# The Odds API key (free plan: 500 credits/month). Leave empty for demo mode.
DOOSRA_ODDS_API_KEY=

# Long random string; the dashboard sends it to unlock refresh, explain and bets.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
DOOSRA_ADMIN_TOKEN=

# Optional AI for plain-language explanations and team-news flags. Tried in this order;
# with none set, Doosra uses its built-in summaries. AI never produces a probability.
# Gemini: key from aistudio.google.com (free tier, or Google AI Pro's $10/month Cloud credit)
GEMINI_API_KEY=
# Groq: key from console.groq.com (free tier; prompts not used for training)
GROQ_API_KEY=
# Claude API: billed separately from a Claude Pro plan
ANTHROPIC_API_KEY=
DOOSRA_LLM_ORDER=gemini,groq,claude

# Cricsheet archive the learning cycle reads (download with: python -m doosra.pipeline download t20s_json.zip)
DOOSRA_CRICSHEET=data/raw/t20s_json.zip

# Storage: a SQLite file locally, or the Neon postgresql://... connection string in the cloud
# (Cloud Run and the GitHub learning cycle). With Postgres, models are kept in the database too.
# DATABASE_URL (as Neon writes it) is used when DOOSRA_DB is not set.
DOOSRA_DB=data/doosra.sqlite
DOOSRA_MODELS_DIR=models

# Credits never spent (so a runaway job can't drain the month).
DOOSRA_CREDIT_RESERVE=50

# Comma-separated dashboard origins allowed to call the API from a browser.
DOOSRA_CORS=http://localhost:3000
